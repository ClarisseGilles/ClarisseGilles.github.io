{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customDatasources": {
    "clarissegilles-curseforge": {
      "defaultRegistryUrlTemplate": "https://clarissegilles.github.io/registry/{{packageName}}.json",
      "transformTemplates": ["$"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track CurseForge file IDs in mc.html mod links",
      "managerFilePatterns": ["/mc\\.html$/"],
      "matchStrings": [
        "href=\"https://www\\.curseforge\\.com/minecraft/(?:modpacks|mc-mods)/(?<slug>[^/]+)/files/(?<currentValue>\\d+)\""
      ],
      "datasourceTemplate": "custom.clarissegilles-curseforge",
      "depNameTemplate": "1.21.1/neoforge/{{slug}}",
      "registryUrlTemplate": "https://clarissegilles.github.io/registry/1.21.1/neoforge/{{slug}}.json",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "CurseForge file IDs are opaque integers, not semver major bumps",
      "matchDatasources": ["custom.clarissegilles-curseforge"],
      "maxMajorIncrement": 0
    }
  ]
}
